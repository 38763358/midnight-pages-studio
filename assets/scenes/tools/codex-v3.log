ne-flex;gap:20px;justify-content:center;align-items:center;min-height:48px;padding:12px 22px;background:var(--navy);color:var(--paper);text-decoration:none;font-size:13px}.btn span{font-family:Instrument,serif;font-size:22px;line-height:1}.hero .btn,.detail-text .btn{margin-top:24px}.buy-note{font-size:12px;color:var(--muted);margin-top:14px;line-height:1.6}.section{margin-block:96px}.section-head{display:flex;justify-content:space-between;gap:32px;align-items:baseline;margin-bottom:32px}.section-note{max-width:680px;color:var(--muted);margin-top:24px}.shop-all{font-size:13px;white-space:nowrap}.price{color:var(--brick);font-family:Instrument,serif}.products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:40px 24px}.product{display:block;text-decoration:none;min-width:0}.product img{aspect-ratio:1;object-fit:contain;background:var(--pale)}.product:hover img{opacity:.92}.product:hover h3{text-decoration:underline;text-underline-offset:4px}.product__heading{display:flex;justify-content:space-between;gap:8px;align-items:baseline;margin-top:16px}.product__heading .price{font-size:22px}.product__desc{font-size:14px;line-height:1.55;color:var(--muted);margin-top:10px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.product__count{font-size:12px;color:var(--muted);margin-top:10px}.product__buy{display:block;font-size:12px;margin-top:8px}.how>h2{margin-bottom:24px}.use-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.use-grid img{aspect-ratio:4/3;object-fit:cover}.use-grid h3{margin-top:20px;margin-bottom:10px;font-size:24px}.use-grid p{color:var(--muted)}.library-details{display:grid;grid-template-columns:7fr 5fr;gap:64px;align-items:center}.library-details img{background:var(--pale)}.detail-text h2{margin-bottom:24px}.detail-text>p+p{margin-top:18px}.detail-text>p:not(.intro){color:var(--muted)}.collection-caption{font-size:12px}.prompts{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:0}.prompt-scene{height:100%;min-height:490px;object-fit:cover}.prompts .detail-text{padding:48px clamp(32px,5vw,80px);max-width:690px}.sample{background:var(--pale);padding-block:48px}.sample__inner{display:flex;align-items:center;justify-content:space-between;gap:64px}.sample h2{margin-bottom:24px}.sample p:not(.intro){max-width:680px;color:var(--muted)}.sample .btn{flex-shrink:0}.footer{background:var(--navy);color:var(--paper);padding:40px 0 28px}.footer__row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px}.footer .wordmark{font-size:12px;letter-spacing:.23em}.footer__links{display:flex;flex-wrap:wrap;gap:8px 24px;font-size:12px}.footer__links a{display:block;padding-block:10px}.footer__fine{width:100%;font-size:12px;border-top:1px solid #fbf8f230;padding-top:24px;color:#d1d4dc}
html.js img{transition:opacity 800ms cubic-bezier(.22,1,.36,1)}html.js img:not(.is-visible){opacity:0}html.show-all img{opacity:1"'!important;transition:none!important}
@media(max-width:1000px){.wordmark{font-size:12px;letter-spacing:.23em}.nav{gap:24px}.library-details{gap:32px}.footer__row{justify-content:flex-start}}
@media(max-width:900px){.products{grid-template-columns:repeat(2,minmax(0,1fr))}.library-details{grid-template-columns:1fr}.library-details figure{max-width:650px;width:100%;margin-inline:auto}.prompts .detail-text{padding:32px}.section-head{align-items:start}.shop-link{font-size:12px}.hero__panel{width:350px}.prompt-scene{min-height:550px}}
@media(max-width:600px){html{scroll-padding-top:110px}.promotion{font-size:10px;line-height:1.7;padding:7px 16px}.promotion a{display:block;margin-left:0}.masthead__row{grid-template-columns:minmax(0,1fr) auto;min-height:65px;gap:12px}.shop-link,.buy-long{display:none}.buy-short{display:inline}.wordmark{font-size:10px;letter-spacing:.18em}.masthead__buy{font-size:12px}.nav{width:100%;padding-inline:20px;justify-content:flex-start;gap:25px;overflow-x:auto;scrollbar-width:thin}.nav li{flex-shrink:0}.nav a{padding-block:12px;font-size:12px}.hero{height:auto;min-height:0;overflow:hidden}.hero__photo{position:relative;height:70vh;height:70svh}.hero__photo img{object-position:center}.hero__panel{position:static;transform:none;width:auto;padding:32px 20px}.hero h1{max-width:320px}.hero__panel>p:not(.intro):not(.buy-note){font-size:15px}.section{margin-block:64px}.section-head{display:block;margin-bottom:24px}.section-head h2{max-width:300px}.shop-all{display:inline-block;margin-top:20px}.products{gap:30px 16px}.product__heading{gap:6px;margin-top:12px}.product h3{font-size:20px}.product__desc{font-size:14px}.product__count,.product__buy{font-size:11px}.product__heading .price{font-size:20px}.use-grid{grid-template-columns:1fr;gap:32px}.use-grid h3{margin-top:16px}.library-details{gap:28px}.prompts{grid-template-columns:1fr}.prompt-scene{min-height:0;height:auto;aspect-ratio:4/3}.prompts .detail-text{padding:32px 20px 0}.sample{padding-block:36px}.sample__inner{display:block}.sample .btn{margin-top:24px}.footer__row{display:block}.footer .wordmark{font-size:11px}.footer__links{margin-block:22px;gap:4px 20px}.footer__fine{padding-top:22px}}
